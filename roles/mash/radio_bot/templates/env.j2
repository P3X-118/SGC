DISCORD_BOT_TOKEN={{ radio_bot_discord_token }}

DEX_API_BASE={{ radio_bot_dex_api_base }}
DEX_API_KEY={{ radio_bot_dex_api_key }}
DEX_MODEL={{ radio_bot_dex_model }}

RECALL_API_BASE={{ radio_bot_recall_api_base }}
RECALL_API_KEY={{ radio_bot_recall_api_key }}
RECALL_COLLECTION={{ radio_bot_recall_collection }}

{% for instance_id, secrets in radio_bot_okast_secrets.items() %}
OKAST_TOKEN_{{ instance_id | upper | regex_replace('[^A-Z0-9]', '_') }}={{ secrets.token | default('') }}
OKAST_HOOK_SECRET_{{ instance_id | upper | regex_replace('[^A-Z0-9]', '_') }}={{ secrets.hook_secret | default('') }}
{% endfor %}

RADIO_BOT_CONFIG=/app/config.json
PORT=8790
{{ radio_bot_environment_variables_additional_variables }}
