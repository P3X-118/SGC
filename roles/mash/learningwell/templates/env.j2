{# Rendered by SGC role: roles/mash/learningwell #}
# App (web) — NEXT_PUBLIC_SITE_URL + AMAZON_AFFILIATE_TAG are baked at image
# build time by deploy.sh; STRIPE_SECRET_KEY is read at runtime.
NEXT_PUBLIC_SITE_URL={{ learningwell_site_url }}
AMAZON_AFFILIATE_TAG={{ learningwell_amazon_affiliate_tag }}
STRIPE_SECRET_KEY={{ learningwell_stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ learningwell_stripe_webhook_secret }}

# Payments: Authorize.Net (runtime). Empty API login/transaction key = checkout
# places orders WITHOUT charging. Provide the transaction key via vault.
AUTHORIZENET_ENV={{ learningwell_authorizenet_env }}
AUTHORIZENET_API_LOGIN_ID={{ learningwell_authorizenet_api_login_id }}
AUTHORIZENET_TRANSACTION_KEY={{ learningwell_authorizenet_transaction_key }}
AUTHORIZENET_CLIENT_KEY={{ learningwell_authorizenet_client_key }}

# Email: transactional mail via the mailcow inbox (runtime). Empty SMTP_PASS =
# senders no-op (logged). Port 465 (the EC2 can't reach 587/25). SMTP_PASS via vault.
SMTP_HOST={{ learningwell_smtp_host }}
SMTP_PORT={{ learningwell_smtp_port }}
SMTP_USER={{ learningwell_smtp_user }}
SMTP_PASS={{ learningwell_smtp_pass }}
MAIL_FROM={{ learningwell_mail_from }}
MAIL_INTERNAL_TO={{ learningwell_mail_internal_to }}

# Odoo (do.sgc.ai) — orders + leads. Empty ODOO_URL = integration inert.
ODOO_URL={{ learningwell_odoo_url }}
ODOO_DB={{ learningwell_odoo_db }}
ODOO_USER={{ learningwell_odoo_user }}
ODOO_API_KEY={{ learningwell_odoo_api_key }}
ODOO_COMPANY_NAME={{ learningwell_odoo_company_name }}
ODOO_BUNDLE_PRODUCT_CODE={{ learningwell_odoo_bundle_product_code }}

# Shared-edge mode: the existing host Caddy's docker network.
TMW_CADDY_NETWORK={{ learningwell_caddy_network }}

# Standalone mode only (ignored in shared mode).
CADDY_EMAIL={{ learningwell_caddy_email }}
CLOUDFLARE_API_TOKEN={{ learningwell_cloudflare_api_token }}
