{# Rendered to {{ legit_services_base_path }}/docker-compose.yml.
   The systemd unit drives this with `docker compose up -d`.
   SPDX-License-Identifier: AGPL-3.0-or-later #}
services:
  app:
    image: ${APP_IMAGE}
    container_name: {{ legit_services_identifier }}
    # Run as the SGC service uid so the bind-mounted radata dir (created by the
    # role under this uid) is writable for Gun. The image's default user is `node`
    # (uid 1000), which doesn't match — and with read_only rootfs the app can only
    # write radata + tmpfs, so the uid must line up or Gun fails with EACCES.
    user: "{{ legit_services_uid }}:{{ legit_services_gid }}"
    restart: unless-stopped
    init: true
    env_file: env
    environment:
      NODE_ENV: production
    networks:
      internal:
        aliases:
          - {{ legit_services_identifier }}
      traefik: {}
    volumes:
      - {{ legit_services_radata_path }}:/app/radata
    tmpfs:
      - /tmp
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8080/healthz"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    depends_on:
      redis:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 256M
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    labels:
{% if legit_services_container_labels_traefik_enabled | bool %}
      traefik.enable: "true"
      traefik.docker.network: "{{ legit_services_container_labels_traefik_docker_network }}"
      # Public router: serves everything that's not gated by the owner
      # router below. Priority kept low so the more-specific owner rule
      # (PathPrefix) wins when both match.
      traefik.http.routers.{{ legit_services_identifier }}.rule: {{ legit_services_container_labels_traefik_rule | trim | to_json }}
      traefik.http.routers.{{ legit_services_identifier }}.entrypoints: "{{ legit_services_container_labels_traefik_entrypoints }}"
      traefik.http.routers.{{ legit_services_identifier }}.tls: "true"
      traefik.http.routers.{{ legit_services_identifier }}.tls.certResolver: "{{ legit_services_container_labels_traefik_tls_certResolver }}"
      traefik.http.routers.{{ legit_services_identifier }}.priority: "10"
      traefik.http.services.{{ legit_services_identifier }}.loadbalancer.server.port: "8080"
{% if legit_services_authentik_enabled | bool %}
      # ── Authentik forward-auth gate for /owner* ─────────────────────
      # Middleware queries the embedded outpost on the colocated
      # Authentik server; on success Traefik injects X-authentik-* headers
      # which the Node app trusts (the container only accepts traffic
      # from this Traefik instance over the internal network).
      traefik.http.middlewares.{{ legit_services_identifier }}-auth.forwardauth.address: "{{ legit_services_authentik_forwardauth_address }}"
      traefik.http.middlewares.{{ legit_services_identifier }}-auth.forwardauth.trustForwardHeader: "true"
      traefik.http.middlewares.{{ legit_services_identifier }}-auth.forwardauth.authResponseHeaders: "X-authentik-username,X-authentik-groups,X-authentik-entitlements,X-authentik-email,X-authentik-name,X-authentik-uid,X-authentik-jwt,X-authentik-meta-jwks,X-authentik-meta-outpost,X-authentik-meta-provider,X-authentik-meta-app,X-authentik-meta-version"

      # Owner router: HTML SPA shell at /owner AND its API at /api/owner*.
      # Priority above the public router so PathPrefix matches first.
      traefik.http.routers.{{ legit_services_identifier }}-owner.rule: "Host(`{{ legit_services_hostname }}`) && (PathPrefix(`/owner`) || PathPrefix(`/api/owner`))"
      traefik.http.routers.{{ legit_services_identifier }}-owner.entrypoints: "{{ legit_services_container_labels_traefik_entrypoints }}"
      traefik.http.routers.{{ legit_services_identifier }}-owner.tls: "true"
      traefik.http.routers.{{ legit_services_identifier }}-owner.tls.certResolver: "{{ legit_services_container_labels_traefik_tls_certResolver }}"
      traefik.http.routers.{{ legit_services_identifier }}-owner.middlewares: "{{ legit_services_identifier }}-auth@docker"
      traefik.http.routers.{{ legit_services_identifier }}-owner.service: "{{ legit_services_identifier }}"
      traefik.http.routers.{{ legit_services_identifier }}-owner.priority: "20"

      # OIDC callback passthrough: Authentik redirects the browser to
      # https://legit.services/outpost.goauthentik.io/callback after sign-in.
      # That path is served by the OUTPOST inside pds-authentik-server, not
      # by this Node app, so route it to that service directly and skip
      # the auth middleware (this IS the auth path).
      traefik.http.routers.{{ legit_services_identifier }}-outpost.rule: "Host(`{{ legit_services_hostname }}`) && PathPrefix(`/outpost.goauthentik.io`)"
      traefik.http.routers.{{ legit_services_identifier }}-outpost.entrypoints: "{{ legit_services_container_labels_traefik_entrypoints }}"
      traefik.http.routers.{{ legit_services_identifier }}-outpost.tls: "true"
      traefik.http.routers.{{ legit_services_identifier }}-outpost.tls.certResolver: "{{ legit_services_container_labels_traefik_tls_certResolver }}"
      traefik.http.routers.{{ legit_services_identifier }}-outpost.service: "pds-authentik-server@docker"
      traefik.http.routers.{{ legit_services_identifier }}-outpost.priority: "30"
{% endif %}
{% else %}
      traefik.enable: "false"
{% endif %}

  redis:
    image: ${REDIS_IMAGE}
    container_name: {{ legit_services_identifier }}-redis
    restart: unless-stopped
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --maxmemory
      - ${REDIS_MAXMEMORY}
      - --maxmemory-policy
      - noeviction
    networks:
      - internal
    volumes:
      - {{ legit_services_redis_path }}:/data
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETUID
      - SETGID
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 10
    deploy:
      resources:
        limits:
          memory: 640M
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  internal:
    name: ${INTERNAL_NET}
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: "${INTERNAL_NET_MTU}"
  traefik:
    name: ${TRAEFIK_NET}
    external: true
