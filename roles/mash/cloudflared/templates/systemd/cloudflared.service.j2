[Unit]
Description=Cloudflared ({{ cloudflared_identifier }})
{% for service in cloudflared_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in cloudflared_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ cloudflared_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ cloudflared_identifier }} 2>/dev/null || true'

{#
  cloudflared runs with host networking so that the dashboard-configured origin
  (e.g. http://localhost:80) reaches the host's Traefik `web` entrypoint.
  It dials outbound to Cloudflare's edge, so no published ports are needed.
#}
ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ cloudflared_identifier }} \
      --log-driver=none \
      --user={{ cloudflared_uid }}:{{ cloudflared_gid }} \
      --cap-drop=ALL \
      --network=host \
      --env-file={{ cloudflared_base_path }}/env \
      {% for arg in cloudflared_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ cloudflared_container_image }}{% for a in cloudflared_container_command %} {{ a }}{% endfor %}


ExecStart={{ sysd_docker_host_command }} start --attach {{ cloudflared_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ cloudflared_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ cloudflared_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ cloudflared_identifier }}

[Install]
WantedBy=multi-user.target
