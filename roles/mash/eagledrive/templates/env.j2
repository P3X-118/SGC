# Rendered by SGC mash/eagledrive role — do not edit on host.
API_HOST=0.0.0.0
API_PORT={{ eagledrive_api_port }}
API_LOG_LEVEL={{ eagledrive_api_log_level }}

POSTGRES_USER={{ eagledrive_postgres_user }}
POSTGRES_PASSWORD={{ eagledrive_postgres_password }}
POSTGRES_DB={{ eagledrive_postgres_db }}
POSTGRES_PORT={{ eagledrive_postgres_port }}
DATABASE_URL=postgres://{{ eagledrive_postgres_user }}:{{ eagledrive_postgres_password }}@postgres:5432/{{ eagledrive_postgres_db }}

REDIS_PORT={{ eagledrive_redis_port }}
REDIS_URL=redis://redis:6379

NTFY_URL={{ eagledrive_ntfy_url }}
NTFY_TOKEN={{ eagledrive_ntfy_token }}
PDS_URL={{ eagledrive_pds_url }}
PDS_PRO_URL={{ eagledrive_pds_pro_url }}
CHANGEDETECTION_URL={{ eagledrive_changedetection_url }}
CHANGEDETECTION_API_KEY={{ eagledrive_changedetection_api_key }}
REITTI_URL={{ eagledrive_reitti_url }}
GUN_RELAY_URL={{ eagledrive_gun_relay_url }}

# MinIO (object storage). Bucket is anon-read; writes use the scoped
# eagledrive-scrapers credentials. PUBLIC_URL_BASE is what we store in
# vendors.image_url after rehosting an IG/FB/Yelp CDN URL.
MINIO_ENDPOINT={{ eagledrive_minio_endpoint | default('') }}
MINIO_BUCKET={{ eagledrive_minio_bucket | default('') }}
MINIO_PUBLIC_URL_BASE={{ eagledrive_minio_public_url_base | default('') }}
MINIO_ACCESS_KEY={{ eagledrive_minio_access_key | default('') }}
MINIO_SECRET_KEY={{ eagledrive_minio_secret_key | default('') }}

# Authentik OIDC (env-gated soft cutover; blank issuer = dormant).
AUTHENTIK_ISSUER={{ eagledrive_authentik_issuer }}
AUTHENTIK_JWKS_URL={{ eagledrive_authentik_jwks_url }}
AUTHENTIK_AUDIENCE={{ eagledrive_authentik_audience }}
AUTHENTIK_CLIENT_ID={{ eagledrive_authentik_client_id }}
AUTHENTIK_ADMIN_GROUP={{ eagledrive_authentik_admin_group }}
AUTHENTIK_MODERATOR_GROUP={{ eagledrive_authentik_moderator_group }}
