{# Rendered by SGC role: roles/mash/texasmodern_signup #}
name: tmw-prod

# Production stack for new.texasmodern.eagledrive.live on AWS EC2 (marketreactor,
# us-east-1, t3.medium). Unlike the sonic-fronted compose at repo root, THIS
# stack owns :80/:443 on the host directly — Caddy in-compose terminates TLS.
# Hostname is Cloudflare-proxied (orange cloud), so Caddy issues the LE cert
# via DNS-01 against Cloudflare (caddy-dns/cloudflare plugin baked into the
# caddy image here).

services:
  caddy:
    build:
      context: ./caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    environment:
      CLOUDFLARE_API_TOKEN: ${CLOUDFLARE_API_TOKEN:?set CLOUDFLARE_API_TOKEN in .env}
      CADDY_EMAIL: ${CADDY_EMAIL:?set CADDY_EMAIL in .env}
      TMW_HOSTNAME: ${TMW_HOSTNAME:-{{ texasmodern_signup_hostname }}}
    volumes:
      - caddy_data:/data
      - caddy_config:/config
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./qr:/srv/qr:ro
      - ./admin:/srv/admin:ro
      # GeoIP database for the maxmind_geolocation matcher. Refreshed
      # weekly on the host by infra/aws/scripts/geoip-update.sh, then
      # caddy reload picks up the new db without a container restart.
      - /opt/tmw/geoip:/etc/caddy/geoip:ro
      # Access log + auto-https log persisted on the host so geo blocks
      # survive container restarts and can be reviewed.
      - /opt/tmw/logs/caddy:/var/log/caddy
    depends_on:
      - web
      - api
      - authentik-proxy

  # Authentik proxy Outpost — gates the admin surface (Caddy forward_auth
  # → authentik-proxy:9000). Connects OUT to the shared Authentik on
  # bskypds.pro over the SGC VPN mesh: extra_hosts pins
  # auth.eagledrive.live to bskypds's mesh IP {{ texasmodern_signup_authentik_mesh_ip }} so the
  # container egresses through the host's `dhd` interface (the public
  # 128.254.161.222 path is not reliably reachable from this EC2).
  # Traefik on bskypds serves the real LE cert for auth.eagledrive.live
  # on that internal address, so TLS verification stays on.
  # Provider/app/group/outpost are provisioned by
  # ~/sgc/apps/authentik/scripts/sgc/provision-texasmodern.py; the token
  # below is that Outpost's API token. Pin the image to the Authentik
  # server's major.minor.
  authentik-proxy:
    # Pinned to the exact patch version of the Authentik server on
    # bskypds — the floating :2025.10 tag drifts ahead and the newer
    # outpost requires `assigned_backchannel_application_slug` in the
    # API response, which 2025.10.3 doesn't emit (outpost crash-loops
    # with "no value given for required property
    # assigned_backchannel_application_slug").
    image: {{ texasmodern_signup_authentik_proxy_image }}:{{ texasmodern_signup_authentik_proxy_image_tag }}
    restart: unless-stopped
    environment:
      AUTHENTIK_HOST: ${AUTHENTIK_HOST:-{{ texasmodern_signup_authentik_host }}}
      AUTHENTIK_INSECURE: "false"
      AUTHENTIK_TOKEN: ${AUTHENTIK_OUTPOST_TOKEN:?set AUTHENTIK_OUTPOST_TOKEN in .env}
    extra_hosts:
      - "auth.eagledrive.live:{{ texasmodern_signup_authentik_mesh_ip }}"
    expose:
      - "9000"

  web:
    build:
      context: ../../web
      args:
        EXPO_PUBLIC_API_URL: ${EXPO_PUBLIC_API_URL-}
        # Serve bundle at site root — Caddy routes /api/* to api and
        # everything else to this nginx, so the Expo assets must live at
        # /_expo/... not /app/_expo/...
        WEB_BASE_URL: ""
    restart: unless-stopped
    expose:
      - "80"

  api:
    build:
      context: ../../api
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 8080
      POSTGRES_HOST: db
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-{{ texasmodern_signup_postgres_user }}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: ${POSTGRES_DB:-{{ texasmodern_signup_postgres_db }}}
      CORS_ORIGINS: ${CORS_ORIGINS:-{{ texasmodern_signup_cors_origins }}}
      # ntfy push notifications. NTFY_BASE_URL empty → publish() no-ops
      # so the form stays functional even before the ntfy server is up.
      NTFY_BASE_URL: ${NTFY_BASE_URL-}
      NTFY_AUTH_TOKEN: ${NTFY_AUTH_TOKEN-}
      NTFY_TOPIC_SIGNUP: ${NTFY_TOPIC_SIGNUP:-{{ texasmodern_signup_ntfy_topic_signup }}}
      NTFY_TOPIC_VIEW: ${NTFY_TOPIC_VIEW:-{{ texasmodern_signup_ntfy_topic_view }}}
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8080"

  migrate:
    build:
      context: ../../api
    restart: "no"
    command: ["node", "dist/migrate.js"]
    environment:
      POSTGRES_HOST: db
      POSTGRES_PORT: 5432
      POSTGRES_USER: ${POSTGRES_USER:-{{ texasmodern_signup_postgres_user }}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: ${POSTGRES_DB:-{{ texasmodern_signup_postgres_db }}}
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-{{ texasmodern_signup_postgres_user }}}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: ${POSTGRES_DB:-{{ texasmodern_signup_postgres_db }}}
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-{{ texasmodern_signup_postgres_user }}} -d ${POSTGRES_DB:-{{ texasmodern_signup_postgres_db }}}"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  caddy_data:
  caddy_config:
  db_data:
