#!/usr/bin/env bash
# FlareSolverr watchdog — managed by ansible (roles/mash/flaresolverr_watchdog).
# DO NOT EDIT BY HAND.
#
# A wedged headless browser keeps FlareSolverr's API responsive (sessions.list
# returns "ok") while every real request.get fails — so a dead browser looks
# healthy to naive "is the port up?" checks and masquerades as an upstream block.
# This probes with a REAL request.get and restarts the service on genuine
# failure (a wedge errors out fast; a merely-busy instance still answers, just
# slowly — hence the generous timeout and two strikes).
set -u
URL="{{ flaresolverr_watchdog_url }}"

probe() {
  curl -fsS --max-time 90 -X POST "$URL" \
    -H 'Content-Type: application/json' \
    -d '{"cmd":"request.get","url":"https://example.com","maxTimeout":80000}' 2>/dev/null \
    | grep -q '"status": "ok"'
}

# Two strikes, 20s apart, so a single transient blip doesn't trigger a restart.
probe && exit 0
sleep 20
probe && exit 0

# Discover the actual unit name (it's prefixed per host, e.g. sgc-flaresolverr).
svc="$(systemctl list-units --type=service --all --no-legend 2>/dev/null \
  | grep -oE '[A-Za-z0-9_.@-]*flaresolverr[A-Za-z0-9_.@-]*\.service' \
  | grep -v watchdog | head -1)"
svc="${svc:-flaresolverr.service}"

logger -t flaresolverr-watchdog "real request.get failed twice — restarting ${svc}"
systemctl restart "${svc}"
