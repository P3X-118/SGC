{#
  caddi backend environment.
  The env contract below mirrors the ecosystem contracts documented in
  apps/caddi/CLAUDE.md (dex LLM, Claude fallback, LocalRecall RAG, authentik OIDC).
  TODO: confirm the exact variable names the backend expects once P3X-118/caddi-backend exists.
#}

TZ={{ caddy_environment_variables_tz }}
BASE_URL={{ caddy_environment_variables_base_url }}
DATABASE_URL={{ caddy_environment_variables_database_url }}
JWT_SECRET={{ caddy_environment_variables_jwt_secret }}

# LLM provider chain (dex -> Claude -> user model). dex = LocalAI on hal, reached via the host's 2nd NIC.
DEX_BASE_URL={{ caddy_environment_variables_dex_base_url }}
DEX_MODEL={{ caddy_environment_variables_dex_model }}
ANTHROPIC_API_KEY={{ caddy_environment_variables_anthropic_api_key }}

# LocalRecall RAG (per-user course-memory collections)
LOCALRECALL_BASE_URL={{ caddy_environment_variables_localrecall_base_url }}

# authentik OIDC (backend is the confidential client; PKCE mobile pattern)
OIDC_ISSUER={{ caddy_environment_variables_oidc_issuer }}
OIDC_CLIENT_ID={{ caddy_environment_variables_oidc_client_id }}
OIDC_CLIENT_SECRET={{ caddy_environment_variables_oidc_client_secret }}

{{ caddy_environment_variables_additional_variables }}
