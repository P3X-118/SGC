[Unit]
Description=wger nginx ({{ wger_nginx_identifier }})
{% for service in wger_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
Requires={{ wger_identifier }}.service
After={{ wger_identifier }}.service
# Re-resolve the gunicorn upstream IP if it restarts: a restart/stop of the
# app unit propagates here, so nginx never proxies to a stale container IP.
PartOf={{ wger_identifier }}.service
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ wger_nginx_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ wger_nginx_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ wger_nginx_identifier }} \
      --user={{ wger_nginx_uid }}:{{ wger_nginx_gid }} \
      --label-file={{ wger_base_path }}/labels \
      --cap-drop=ALL \
      --security-opt=no-new-privileges:true \
      --read-only \
      --tmpfs=/tmp:rw,mode=1777 \
      --network={{ wger_container_network }} \
      --entrypoint=nginx \
      --volume={{ wger_nginx_config_path }}:/etc/nginx/nginx.conf:ro \
      --volume={{ wger_static_path }}:/static:ro \
      --volume={{ wger_media_path }}:/media:ro \
      {% for arg in wger_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ wger_nginx_container_image }} \
      -g 'daemon off;'

{% for network in wger_nginx_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ wger_nginx_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ wger_nginx_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ wger_nginx_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ wger_nginx_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ wger_nginx_identifier }}

[Install]
WantedBy=multi-user.target
