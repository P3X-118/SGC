[Unit]
Description=wger ({{ wger_identifier }})
{% for service in wger_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in wger_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ wger_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ wger_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ wger_identifier }} \
      --user={{ wger_uid }}:{{ wger_gid }} \
      {% if not wger_nginx_enabled | bool %}
      --label-file={{ wger_base_path }}/labels \
      {% endif %}
      --cap-drop=ALL \
      --security-opt=no-new-privileges:true \
      {% if wger_container_memory %}
      --memory={{ wger_container_memory }} \
      {% endif %}
      {% if wger_container_memory and wger_container_memory_swap %}
      --memory-swap={{ wger_container_memory_swap }} \
      {% endif %}
      --network={{ wger_container_network }} \
      {% if wger_container_http_host_bind_port %}
      -p {{ wger_container_http_host_bind_port }}:{{ wger_container_http_port }} \
      {% endif %}
      --env-file={{ wger_base_path }}/env \
      --volume={{ wger_media_path }}:/home/wger/media:rw \
      --volume={{ wger_static_path }}:/home/wger/static:rw \
      {% for volume in wger_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      {% for arg in wger_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ wger_container_image }}

{% for network in wger_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ wger_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ wger_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ wger_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ wger_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ wger_identifier }}

[Install]
WantedBy=multi-user.target
