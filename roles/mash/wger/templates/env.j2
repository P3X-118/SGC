# Managed by Ansible (wger-ar role) — do not edit by hand.
# Consumed by settings.main via django-environ.
TZ={{ wger_time_zone }}
TIME_ZONE={{ wger_time_zone }}

DJANGO_DEBUG={{ wger_django_debug }}
SECRET_KEY={{ wger_effective_secret_key }}
SITE_URL={{ wger_site_url }}
CSRF_TRUSTED_ORIGINS={{ wger_csrf_trusted_origins }}
{% if wger_behind_reverse_proxy | bool %}
X_FORWARDED_PROTO_HEADER_SET=True
{% endif %}
{% if wger_jwt_private_key and wger_jwt_public_key %}
JWT_PRIVATE_KEY={{ wger_jwt_private_key }}
JWT_PUBLIC_KEY={{ wger_jwt_public_key }}
{% endif %}

# Web / startup behaviour (entrypoint.sh)
WGER_USE_GUNICORN={{ wger_use_gunicorn }}
WGER_PORT={{ wger_container_http_port }}
DJANGO_PERFORM_MIGRATIONS={{ wger_perform_migrations }}
DJANGO_COLLECTSTATIC_ON_STARTUP={{ wger_collectstatic_on_startup }}

# Files (paths inside the container; host dirs are bind-mounted to these)
DJANGO_MEDIA_ROOT=/home/wger/media
DJANGO_STATIC_ROOT=/home/wger/static

# Database
DJANGO_DB_ENGINE={{ wger_database_engine }}
DJANGO_DB_DATABASE={{ wger_database_name }}
DJANGO_DB_USER={{ wger_database_username }}
DJANGO_DB_PASSWORD={{ wger_database_password }}
DJANGO_DB_HOST={{ wger_database_hostname }}
DJANGO_DB_PORT={{ wger_database_port }}
{% if wger_redis_enabled %}

# Cache (Redis) — also fixes django-axes shared-cache requirement
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION={{ wger_cache_location }}
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient
{% endif %}

# Celery
USE_CELERY={{ 'True' if wger_celery_enabled | bool else 'False' }}
{% if wger_celery_enabled | bool %}
CELERY_BROKER={{ wger_celery_broker }}
CELERY_BACKEND={{ wger_celery_backend }}
CELERY_WORKER_CONCURRENCY={{ wger_celery_worker_concurrency }}
{% endif %}
{% if wger_email_enabled | bool %}

# Email
ENABLE_EMAIL=True
EMAIL_HOST={{ wger_email_host }}
EMAIL_PORT={{ wger_email_port }}
EMAIL_HOST_USER={{ wger_email_host_user }}
EMAIL_HOST_PASSWORD={{ wger_email_host_password }}
EMAIL_USE_TLS={{ wger_email_use_tls }}
EMAIL_USE_SSL={{ wger_email_use_ssl }}
FROM_EMAIL={{ wger_from_email }}
{% endif %}

# Branding seam (empty => stock wger chrome)
{% if wger_site_name %}
SITE_NAME={{ wger_site_name }}
{% endif %}
{% if wger_brand_logo_url %}
BRAND_LOGO_URL={{ wger_brand_logo_url }}
{% endif %}
{% if wger_brand_favicon_url %}
BRAND_FAVICON_URL={{ wger_brand_favicon_url }}
{% endif %}
{% if wger_custom_css_url %}
CUSTOM_CSS_URL={{ wger_custom_css_url }}
{% endif %}
{% if wger_brand_color_mode %}
BRAND_COLOR_MODE={{ wger_brand_color_mode }}
{% endif %}
{% if wger_sso_default_weight_unit %}
SSO_DEFAULT_WEIGHT_UNIT={{ wger_sso_default_weight_unit }}
{% endif %}

# Feature toggles
ALLOW_REGISTRATION={{ wger_allow_registration }}
ALLOW_GUEST_USERS={{ wger_allow_guest_users }}
{% set _social = (wger_social_providers.split(',') if wger_social_providers else []) + (['openid_connect'] if wger_oidc_enabled | bool else []) %}
{% set _social = _social | map('trim') | reject('equalto', '') | unique | list %}
{% if _social %}

# SSO / social login (django-allauth)
WGER_SOCIAL_PROVIDERS={{ _social | join(',') }}
{% endif %}
{% if wger_oidc_enabled | bool %}
OIDC_PROVIDER_ID={{ wger_oidc_provider_id }}
OIDC_PROVIDER_NAME={{ wger_oidc_provider_name }}
OIDC_CLIENT_ID={{ wger_oidc_client_id }}
OIDC_CLIENT_SECRET={{ wger_oidc_client_secret }}
OIDC_SERVER_URL={{ wger_oidc_server_url }}
OIDC_ADMIN_GROUPS={{ wger_oidc_admin_groups }}
OIDC_LOGIN_AUTOREDIRECT={{ wger_oidc_login_autoredirect }}
{% if wger_oidc_end_session_url %}
OIDC_END_SESSION_URL={{ wger_oidc_end_session_url }}
OIDC_POST_LOGOUT_REDIRECT_PATH={{ wger_oidc_post_logout_redirect_path }}
{% endif %}
{% endif %}
{% if wger_environment_variables_additional_variables %}
{{ wger_environment_variables_additional_variables }}
{% endif %}
