[Unit]
Description=Odoo (do) ({{ do_identifier }})
{% for service in do_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in do_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ do_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ do_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ do_identifier }} \
      --log-driver=none \
      --user={{ do_uid }}:{{ do_gid }} \
      --cap-drop=ALL \
      --network={{ do_container_network }} \
      {% if do_container_http_host_bind_port %}
      -p {{ do_container_http_host_bind_port }}:{{ do_container_http_port }} \
      {% endif %}
      {% if do_container_gevent_host_bind_port %}
      -p {{ do_container_gevent_host_bind_port }}:{{ do_container_gevent_port }} \
      {% endif %}
      --env-file={{ do_base_path }}/env \
      --label-file={{ do_base_path }}/labels \
      --mount type=bind,src={{ do_base_path }}/odoo.conf,dst=/etc/odoo/odoo.conf,readonly \
      --mount type=bind,src={{ do_data_path }},dst=/var/lib/odoo \
      {% if do_extra_addons_enabled %}
      --mount type=bind,src={{ do_extra_addons_path }},dst=/mnt/extra-addons,readonly \
      {% endif %}
      {% for volume in do_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      {% for arg in do_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ do_container_image_self_build_name if do_container_image_self_build else do_container_image }}

{% for network in do_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ do_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ do_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ do_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ do_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ do_identifier }}

[Install]
WantedBy=multi-user.target
